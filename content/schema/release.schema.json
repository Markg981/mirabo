{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release.schema.json",
  "title": "Rilascio e sostenibilità: budget, assistenza, manutenzione, rinvii, registro delle criticità, decisione di pubblicazione",
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "approval": {
      "description": "Chi ha approvato e quando: null finché è una proposta.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["by", "date"],
          "properties": { "by": { "type": "string", "minLength": 2 }, "date": { "$ref": "#/$defs/date" } }
        }
      ]
    },
    "amount": { "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }] },
    "budgetItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "item", "amount", "basis"],
      "properties": {
        "category": { "enum": ["asset", "revisione", "consulenze", "dispositivi", "account-distribuzione", "supporto", "manutenzione", "tempo-personale"] },
        "item": { "type": "string", "minLength": 3 },
        "amount": { "$ref": "#/$defs/amount", "description": "Euro nel primo anno. Per il tempo personale si ricava da ore e valore orario." },
        "basis": { "enum": ["stima", "preventivo", "fattura", "tempo-personale"] },
        "hours": { "$ref": "#/$defs/amount" },
        "hourlyValue": { "$ref": "#/$defs/amount" },
        "note": { "type": "string" }
      },
      "if": { "properties": { "category": { "const": "tempo-personale" } } },
      "then": { "required": ["hours", "hourlyValue"], "properties": { "basis": { "const": "tempo-personale" }, "amount": { "type": "null" } } }
    },
    "funding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "kind", "amount", "status"],
      "properties": {
        "source": { "type": "string", "minLength": 3 },
        "kind": { "enum": ["proprio", "contributo", "ricavi-famiglie", "ricavi-scuole", "altro"] },
        "amount": { "$ref": "#/$defs/amount" },
        "status": { "enum": ["ipotesi", "confermato", "contrattualizzato"] },
        "evidence": { "type": ["string", "null"] }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "firstReplyWorkingDays", "steps", "limits"],
      "properties": {
        "id": { "enum": ["contenuto-problematico", "perdita-dati", "accesso-adulto", "privacy-sicurezza", "altro"] },
        "when": { "type": "string" },
        "firstReplyWorkingDays": { "type": "integer", "minimum": 1 },
        "steps": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "limits": { "type": "string", "description": "Che cosa l'assistenza non può fare: senza server non ha i dati della famiglia." }
      }
    },
    "maintenanceTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task", "cadenceMonths", "trigger", "owner", "check", "lastDone", "evidence"],
      "properties": {
        "id": { "enum": ["piattaforme", "dipendenze", "correzioni-editoriali", "riesame-privacy", "chiave-e-account"] },
        "task": { "type": "string" },
        "cadenceMonths": { "type": "integer", "minimum": 1, "maximum": 12 },
        "trigger": { "type": "string", "description": "Cosa la fa partire prima della scadenza." },
        "owner": { "type": "string" },
        "check": { "type": "string" },
        "lastDone": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/date" }] },
        "evidence": { "type": ["string", "null"] }
      }
    },
    "deferral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "what", "reason", "decided", "owner", "reopenWhen", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "what": { "type": "string" },
        "reason": { "type": "string" },
        "decided": { "$ref": "#/$defs/date" },
        "owner": { "type": "string" },
        "feature": { "type": "string", "description": "Costante di app/lib/features.dart che resta spenta finché il rinvio vale." },
        "reopenWhen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "condition"],
            "properties": {
              "kind": { "enum": ["bisogno", "budget", "progettazione", "legale", "capacita", "esterno"] },
              "condition": { "type": "string", "minLength": 10 }
            }
          }
        },
        "status": { "enum": ["rinviato", "riaperto"] },
        "reopened": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "evidence"],
          "properties": { "date": { "$ref": "#/$defs/date" }, "evidence": { "type": "string", "minLength": 3 } }
        }
      },
      "if": { "properties": { "status": { "const": "riaperto" } } },
      "then": { "required": ["reopened"] }
    },
    "verification": {
      "description": "Il risultato verificato, non il lavoro fatto: versione del contenuto e build su cui l'evidenza è stata osservata.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contentVersion", "build", "date", "by", "result"],
          "properties": {
            "contentVersion": { "type": "string" },
            "build": { "type": "string" },
            "date": { "$ref": "#/$defs/date" },
            "by": { "type": "string" },
            "result": { "type": "string", "minLength": 10 }
          }
        }
      ]
    },
    "criticality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "criticality", "intervention", "owner", "evidenceRequired", "verification", "status", "residualRisk", "blocking"],
      "properties": {
        "id": { "type": "string", "pattern": "^\\d{2}[a-z]?$" },
        "criticality": { "type": "string" },
        "intervention": { "type": "string" },
        "owner": { "type": "string" },
        "evidenceRequired": { "type": "string" },
        "check": { "type": "string", "description": "Il controllo che produce l'evidenza, quando c'è." },
        "verification": { "$ref": "#/$defs/verification" },
        "status": { "enum": ["aperta", "in-lavorazione", "da-verificare", "risolta", "rinviata"] },
        "residualRisk": { "type": "string" },
        "blocking": { "type": "boolean", "description": "true: la pubblicazione aspetta che sia risolta; non si può rinviare." },
        "deferral": { "type": "string", "description": "Id in deferrals.json, per una criticità rinviata." },
        "docs": { "type": "string" }
      }
    },
    "offlineCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "build", "date", "outcome"],
      "properties": {
        "case": { "enum": ["OFF-1", "OFF-2", "OFF-3", "OFF-4", "OFF-5", "OFF-6", "OFF-7"] },
        "build": { "type": "string" },
        "date": { "$ref": "#/$defs/date" },
        "outcome": { "enum": ["superato", "non-superato", "non-applicabile"] },
        "note": { "type": "string" }
      },
      "if": { "properties": { "outcome": { "const": "non-applicabile" } } },
      "then": { "required": ["note"] }
    }
  },
  "type": "object",
  "properties": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstYear", "currency", "approved", "items", "funding"],
      "properties": {
        "firstYear": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["from", "to"],
              "properties": { "from": { "$ref": "#/$defs/date" }, "to": { "$ref": "#/$defs/date" } } }
          ]
        },
        "currency": { "const": "EUR" },
        "approved": { "$ref": "#/$defs/approval" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/budgetItem" } },
        "funding": { "type": "array", "items": { "$ref": "#/$defs/funding" } }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "owner", "hoursPerWeek", "approved", "procedures"],
      "properties": {
        "channel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "address", "publishedIn"],
          "properties": {
            "kind": { "const": "email" },
            "address": { "type": ["string", "null"], "pattern": "^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$" },
            "publishedIn": { "type": "array", "items": { "type": "string" } }
          }
        },
        "owner": { "type": "string" },
        "hoursPerWeek": { "$ref": "#/$defs/amount" },
        "approved": { "$ref": "#/$defs/approval" },
        "procedures": { "type": "array", "items": { "$ref": "#/$defs/procedure" } }
      }
    },
    "maintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "tasks"],
      "properties": {
        "approved": { "$ref": "#/$defs/approval" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/maintenanceTask" } }
      }
    },
    "deferrals": { "type": "array", "items": { "$ref": "#/$defs/deferral" } },
    "criticalities": { "type": "array", "items": { "$ref": "#/$defs/criticality" } },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "date", "by", "build", "contentVersion", "storeChecklist", "offline", "basis"],
      "properties": {
        "decision": { "enum": [null, "pubblicare", "rinviare"] },
        "date": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/date" }] },
        "by": { "type": ["string", "null"] },
        "build": { "type": ["string", "null"], "description": "La build di distribuzione su cui si decide." },
        "contentVersion": { "type": ["string", "null"], "description": "dist/release.json della stessa release." },
        "storeChecklist": {
          "description": "docs/store/checklist-release.md ripetuta su questa build.",
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["build", "date", "by"],
              "properties": { "build": { "type": "string" }, "date": { "$ref": "#/$defs/date" }, "by": { "type": "string" } } }
          ]
        },
        "offline": { "type": "array", "items": { "$ref": "#/$defs/offlineCase" } },
        "basis": { "type": ["string", "null"], "description": "Su quali evidenze si decide; per 'rinviare', che cosa manca." }
      }
    }
  }
}
