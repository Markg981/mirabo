{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mirabo/variant",
  "title": "Mirabò story variant for one age band",
  "type": "object",
  "required": ["ageBand", "screens"],
  "additionalProperties": false,
  "$defs": {
    "companionLines": {
      "type": "object",
      "required": ["bo", "pilu", "tango"],
      "additionalProperties": false,
      "properties": {
        "bo": { "type": "string", "minLength": 1 },
        "pilu": { "type": "string", "minLength": 1 },
        "tango": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "ageBand": { "enum": ["3-5", "6-7", "8-10"] },
    "design": {
      "description": "Scelte di progetto della variante, controllate contro la scheda della fascia (content/education/bands.json).",
      "type": "object",
      "required": ["perspective", "structure"],
      "additionalProperties": false,
      "properties": {
        "perspective": { "enum": ["protagonist", "other", "several"] },
        "structure": { "enum": ["one-problem", "cause-effect", "dilemma"] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["n", "kind", "illustration"],
        "additionalProperties": false,
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["hook", "situation", "dialogue", "lesson", "gesture", "consequence", "turn", "closing"] },
          "illustration": {
            "type": "object",
            "required": ["alt"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "alt": { "type": "string", "minLength": 10 },
              "scene": {
                "description": "Illustrazione composta finché non c'è il file: sfondo dipinto e figure posizionate",
                "type": "object",
                "required": ["bg", "items"],
                "additionalProperties": false,
                "properties": {
                  "bg": { "enum": ["room", "forest", "stream", "sky", "night", "snow", "winter-night"] },
                  "dirty": { "type": "boolean" },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["x", "y", "s"],
                      "additionalProperties": false,
                      "properties": {
                        "e": { "type": "string", "minLength": 1 },
                        "paint": { "enum": ["companion", "volcano", "tower", "pebble"] },
                        "x": { "type": "number", "minimum": 0, "maximum": 1 },
                        "y": { "type": "number", "minimum": 0, "maximum": 1 },
                        "s": { "type": "number", "exclusiveMinimum": 0, "maximum": 1.5 },
                        "rot": { "type": "number" },
                        "flip": { "type": "boolean" },
                        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                        "color": { "enum": ["red", "orange", "pink", "green"] },
                        "variant": { "enum": ["tall", "leaning", "fallen", "wide"] },
                        "smoke": { "type": "boolean" },
                        "flower": { "type": "boolean" },
                        "flag": { "type": "boolean" }
                      },
                      "oneOf": [{ "required": ["e"] }, { "required": ["paint"] }]
                    }
                  }
                }
              }
            }
          },
          "text": { "type": "string" },
          "audio": {
            "type": "object",
            "required": ["file"],
            "additionalProperties": false,
            "properties": {
              "file": { "type": "string" },
              "words": {
                "type": "array",
                "items": {
                  "type": "array",
                  "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "string" }],
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "nameSlots": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
            }
          },
          "companionLines": { "$ref": "#/$defs/companionLines" },
          "keyPhrase": { "type": "boolean" },
          "sharedPrompt": {
            "description": "Invito facoltativo al dialogo nella lettura insieme (solo in modalità insieme). Nessuna risposta giusta.",
            "type": "object",
            "required": ["role", "text"],
            "additionalProperties": false,
            "properties": {
              "role": { "enum": ["help", "guide"] },
              "text": { "type": "string", "minLength": 1 }
            }
          },
          "lesson": {
            "description": "Lezione in tre tempi (solo fascia 3-5): si nomina, si riconosce, si ricorda",
            "type": "object",
            "required": ["together", "items", "ask", "done"],
            "additionalProperties": false,
            "properties": {
              "together": { "type": "string", "minLength": 1 },
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "required": ["id", "e", "name", "this", "show"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                    "e": { "type": "string", "minLength": 1 },
                    "name": { "type": "string", "minLength": 1 },
                    "this": { "type": "string", "minLength": 1 },
                    "show": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "ask": { "type": "string", "minLength": 1 },
              "done": { "type": "string", "minLength": 1 }
            }
          },
          "gesture": {
            "description": "Pausa di gesto: la storia si ferma e il bambino fa il gesto con il corpo, poi si riprende",
            "type": "object",
            "required": ["e", "seconds", "together", "back"],
            "additionalProperties": false,
            "properties": {
              "e": { "type": "string", "minLength": 1 },
              "seconds": { "type": "integer", "minimum": 5, "maximum": 60 },
              "together": { "type": "string", "minLength": 1 },
              "back": { "$ref": "#/$defs/companionLines" }
            }
          },
          "consequence": {
            "description": "Pausa di conseguenza: il bambino prova una mossa sul problema della storia, il racconto ne mostra l'esito e si può riprovare",
            "type": "object",
            "required": ["together", "prompt", "options"],
            "additionalProperties": false,
            "properties": {
              "together": { "type": "string", "minLength": 1 },
              "prompt": { "$ref": "#/$defs/companionLines" },
              "minTries": { "type": "integer", "minimum": 1, "maximum": 3 },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "required": ["id", "icon", "label", "outcome", "reaction"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                    "icon": { "type": "string" },
                    "label": { "type": "string", "minLength": 1 },
                    "outcome": { "type": "string", "minLength": 1 },
                    "reaction": { "$ref": "#/$defs/companionLines" }
                  }
                }
              }
            }
          },
          "dialogue": {
            "type": "object",
            "required": ["together", "alone"],
            "additionalProperties": false,
            "properties": {
              "together": { "type": "string", "minLength": 1 },
              "alone": {
                "type": "object",
                "required": ["prompt", "options"],
                "additionalProperties": false,
                "properties": {
                  "prompt": { "$ref": "#/$defs/companionLines" },
                  "options": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "required": ["id", "icon", "label", "reaction"],
                      "additionalProperties": false,
                      "properties": {
                        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                        "icon": { "type": "string" },
                        "label": { "type": "string", "minLength": 1 },
                        "reaction": { "$ref": "#/$defs/companionLines" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
