{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mirabo/story",
  "title": "Mirabò story metadata",
  "type": "object",
  "required": ["id", "version", "title", "world", "topic", "ageBands", "formats", "togetherOnly", "keyPhrase", "parentCard", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "world": { "enum": ["emozioni", "inclusione", "ambiente", "sicurezza"] },
    "topic": { "type": "string", "minLength": 1 },
    "series": { "type": "string" },
    "episode": { "type": "integer", "minimum": 1 },
    "ageBands": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "3-5": { "type": "string" },
        "5-7": { "type": "string" },
        "7-10": { "type": "string" }
      }
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["illustrated", "audio", "choices", "animation"] }
    },
    "togetherOnly": { "type": "boolean" },
    "keyPhrase": { "type": "string", "minLength": 1 },
    "gesture": { "type": "string" },
    "parentCard": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "string" } },
    "reviewedBy": { "type": "string" },
    "status": { "enum": ["draft", "review", "published"] }
  }
}
