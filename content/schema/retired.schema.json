{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mirabo/retired",
  "title": "Elenco firmato delle versioni ritirate",
  "type": "object",
  "required": ["sequence", "retired"],
  "additionalProperties": false,
  "properties": {
    "sequence": { "type": "integer", "minimum": 1 },
    "retired": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "versions": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
          "maxVersion": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "oneOf": [{ "required": ["versions"] }, { "required": ["maxVersion"] }]
      }
    },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  }
}
